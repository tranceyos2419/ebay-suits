# Copy to .env (chmod 600). .env is the only place secrets are kept.
SHIPANDCO_API_TOKEN=

# eBay app keys (developer.ebay.com -> Application Keys)
EBAY_APP_CLIENT_ID=
EBAY_APP_CLIENT_SECRET=
EBAY_APP_RU_NAME=

# eBay seller accounts. The tokens below are written by src/auth/ebay_login.ts
# and src/auth/ebay_auth.ts; see the layout at the top of ebay_auth.ts.
EBAY_ACCOUNTS=jdm-direct-motors,love-of-japan
EBAY_JDM_DIRECT_MOTORS_AUTHNAUTH_TOKEN=
EBAY_LOVE_OF_JAPAN_AUTHNAUTH_TOKEN=
